# Server Port (default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas M0 cluster)
# Local: mongodb://localhost:27017/smartattend_v2
# Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smartattend_v2?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smartattend_v2

# JWT Secret for session authentication (REQUIRED: minimum 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars_123456789

# QR Secret for synchronized time-window HMAC derivation (REQUIRED: minimum 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=replace_with_a_secure_random_qr_secret_min_32_chars_123456789

# Public Application Base URL (used for camera QR deep links and password-reset links)
# In production on Render/Railway: https://<your-app>.onrender.com
# In local development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Unified QR & PIN Rotation Interval in seconds (default: 30)
QR_ROTATION_INTERVAL_SECONDS=30

# Default Mandatory Attendance Compliance Threshold (%)
DEFAULT_ATTENDANCE_THRESHOLD=75

# Optional SMTP Email Alerts Configuration (Nodemailer)
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
